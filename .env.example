# Chỉ tên biến, không giá trị. Giá trị thật nằm trong .env trên máy chủ repo.
# Một GEMINI_API_KEY gọi được mọi mô hình Gemini/Gemma trên cùng project; chỉ đổi tên mô hình.
GEMINI_API_KEY=
MODEL_PROVIDER=gemini
MODEL_ID=gemma-4-31b-it
FALLBACK_MODEL_ID=gemma-4-26b-a4b-it
REFERENCE_MODEL_ID=gemini-3.8-flash
EMBEDDING_MODEL_ID=gemini-embedding-2
EMBEDDING_DIM=
DATABASE_URL=
SPEND_CAP_USD=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=realm_access.roles
OIDC_CUSTOMER_ID_CLAIM=customer_id
LRH_ROUTE_CATALOG=
LRH_CONVERSATION_DB=data/private/conversations.sqlite3
LRH_API_MAX_BODY_BYTES=16384
LRH_API_MAX_QUESTION_CHARS=8000
LRH_API_RATE_LIMIT_PER_MINUTE=30
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# Host system (host/): chạy riêng, có cấu hình riêng
LRH_HOST_URL=
POSTGRES_PASSWORD=
HOST_OIDC_ISSUER=
HOST_OIDC_AUDIENCE=
HOST_OIDC_JWKS_URL=
# Host: server dùng role app (DATABASE_URL), migrate/seed dùng role chủ bảng (MIGRATE_DATABASE_URL)
MIGRATE_DATABASE_URL=
HOST_APP_PASSWORD=
HOST_TEST_DATABASE_URL=
HOST_TEST_APP_DATABASE_URL=
